<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvCreateReminder"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_38sdp"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:layout_marginEnd="@dimen/_12sdp"
        android:background="@drawable/custom_edittext_spinner_bg"
        android:backgroundTint="@color/primary"
        android:fontFamily="@font/fig_tree_medium"
        android:gravity="center"
        android:text="Create Reminder"
        android:textColor="@color/white"
        android:textSize="@dimen/_12sdp"
        tools:ignore="HardcodedText" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvReminder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:layout_marginEnd="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_6sdp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/llAddReminderView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:layout_marginEnd="@dimen/_12sdp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_42sdp"
            android:background="@drawable/custom_edittext_spinner_bg"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/_12sdp"
            android:paddingEnd="@dimen/_12sdp">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                android:src="@drawable/ic_edittext_pen" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etAbout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/fig_tree_medium"
                android:hint="Remind me about"
                android:paddingBottom="@dimen/_1sdp"
                android:textColor="@color/gray"
                android:textColorHint="@color/gray"
                android:textSize="@dimen/_12sdp"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_42sdp"
            android:layout_marginTop="@dimen/_6sdp"
            android:background="@drawable/custom_edittext_spinner_bg"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/_12sdp"
            android:paddingEnd="@dimen/_12sdp">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                android:padding="@dimen/_1sdp"
                android:src="@drawable/ic_reminder_time" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_weight="1"
                android:fontFamily="@font/fig_tree_medium"
                android:paddingBottom="@dimen/_1sdp"
                android:text="Select date &amp; time"
                android:textColor="@color/gray"
                android:textSize="@dimen/_12sdp"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:scrollbars="none"
            tools:ignore="UselessParent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivRed"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_margin="@dimen/_4sdp"
                    android:background="@drawable/custom_circle"
                    android:backgroundTint="#FF0000" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivBlack"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_margin="@dimen/_4sdp"
                    android:background="@drawable/custom_circle"
                    android:backgroundTint="#000000" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivGray"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_margin="@dimen/_4sdp"
                    android:background="@drawable/custom_circle"
                    android:backgroundTint="#858E97" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivBlue"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_margin="@dimen/_4sdp"
                    android:background="@drawable/custom_circle"
                    android:backgroundTint="#1E5EFF" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivGreen"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_margin="@dimen/_4sdp"
                    android:background="@drawable/custom_circle"
                    android:backgroundTint="#00B140" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivPurple"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_margin="@dimen/_4sdp"
                    android:background="@drawable/custom_circle"
                    android:backgroundTint="#7A00D4" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivYellow"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_margin="@dimen/_4sdp"
                    android:background="@drawable/custom_circle"
                    android:backgroundTint="#F3CF3C" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivOrange"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_margin="@dimen/_4sdp"
                    android:background="@drawable/custom_circle"
                    android:backgroundTint="#FF6A1A" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivSkyblue"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_margin="@dimen/_4sdp"
                    android:background="@drawable/custom_circle"
                    android:backgroundTint="#12A4E8" />

            </LinearLayout>

        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnNo"
                android:layout_width="0dp"
                android:layout_height="@dimen/_36sdp"
                android:layout_marginEnd="@dimen/_6sdp"
                android:layout_weight="1"
                android:background="@drawable/custom_button_opacity_10"
                android:backgroundTint="@color/gray"
                android:fontFamily="@font/fig_tree_medium"
                android:gravity="center"
                android:paddingStart="@dimen/_6sdp"
                android:paddingEnd="@dimen/_6sdp"
                android:singleLine="true"
                android:text="No"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp"
                tools:ignore="HardcodedText" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnYes"
                android:layout_width="0dp"
                android:layout_height="@dimen/_36sdp"
                android:layout_marginStart="@dimen/_6sdp"
                android:layout_weight="1"
                android:background="@drawable/custom_button_round"
                android:fontFamily="@font/fig_tree_medium"
                android:gravity="center"
                android:paddingStart="@dimen/_6sdp"
                android:paddingEnd="@dimen/_6sdp"
                android:singleLine="true"
                android:text="Yes"
                android:textColor="@color/white"
                android:textSize="@dimen/_12sdp"
                tools:ignore="HardcodedText" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>